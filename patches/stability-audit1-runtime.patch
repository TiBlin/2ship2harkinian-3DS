+uint16_t ReadTextureDimension(const std::shared_ptr<Ship::BinaryReader>& reader) {
+    const uint32_t value = reader->ReadUInt32();
+    if (value == 0 || value > std::numeric_limits<uint16_t>::max()) {
+        throw std::runtime_error("Texture: invalid dimension");
+    }
+    return static_cast<uint16_t>(value);
+}
+
+void AttachTexturePayload(const std::shared_ptr<Texture>& texture, const std::shared_ptr<Ship::File>& file,
+                          const std::shared_ptr<Ship::BinaryReader>& reader) {
+    const size_t offset = reader->GetBaseAddress();
+    if (!file->Buffer || offset > file->Buffer->size() || texture->ImageDataSize == 0 ||
+        texture->ImageDataSize > file->Buffer->size() - offset) {
+        throw std::runtime_error("Texture: payload exceeds file buffer");
+    }
+    // Keep zero-copy ownership, but never publish an unchecked span. This checks
+    // storage bounds, not every renderer-specific interpretation of the format.
+    texture->mImageBuffer = file->Buffer;
+    texture->ImageData = reinterpret_cast<uint8_t*>(file->Buffer->data() + offset);
+}
