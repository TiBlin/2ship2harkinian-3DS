+extern "C" void TwoShip3dsRecordDepartingObjects(const s16* ids, s32 count) {
+    sTwoShip3dsDepartingObjectCount = 0;
+    sTwoShip3dsDepartingPlayRecorded = true;
+    const s32 capacity = sizeof(sTwoShip3dsDepartingObjects) / sizeof(sTwoShip3dsDepartingObjects[0]);
+    if (ids == nullptr || count <= 0) {
+        return;
+    }
+    if (count > capacity) {
