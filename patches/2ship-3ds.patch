 extern "C" void OTRExtScanner() {
+#ifdef __3DS__
+    // MM's 50k extensionless resources already have an authoritative archive
+    // index. The desktop cache stored three copies of each such path (the
+    // last Split token was the entire path), costing several MiB of strings.
+    // Only extension aliases and normalized backslash names need storage.
+    ExtensionAliases.clear();
+    const auto archiveManager = Ship::Context::GetRawInstance()->GetResourceManager()->GetArchiveManager();
+    const auto archives = archiveManager->GetArchives();
+    for (const auto& archive : *archives) {
+        if (archive == nullptr) {
+            continue;
+        }
+        const auto files = archive->ListFiles();
+        for (const auto& [hash, rPath] : *files) {
+            if (archiveManager->HashToString(hash) != &rPath) {
+                continue; // Preserve the highest-priority archive's name.
+            }
+            const auto dot = rPath.find_last_of('.');
+            if (dot == std::string::npos && rPath.find('\\') == std::string::npos) {
+                continue;
+            }
+            std::string base = rPath.substr(0, dot);
+            std::replace(base.begin(), base.end(), '\\', '/');
+            ExtensionAliases.insert(std::move(base));
+        }
