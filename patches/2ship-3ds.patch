+static bool TwoShip3dsReleaseDirectory(const std::shared_ptr<Ship::ResourceManager>& manager,
+                                      const std::string& pattern, bool preserveExternalOwners) {
+    auto files = manager->GetArchiveManager()->ListFiles(pattern);
+    if (files == nullptr) {
+        return false;
+    }
+    if (preserveExternalOwners) {
+        for (const auto& file : *files) {
+            auto resource = manager->GetCachedResource(file);
+            // One cache owner plus this probe is the unpinned baseline.
+            if (resource != nullptr && resource.use_count() > 2) {
+                return false;
+            }
+            if (file.ends_with(".meta")) {
+                resource = manager->GetCachedResource(file.substr(0, file.size() - 5));
+                if (resource != nullptr && resource.use_count() > 2) {
+                    return false;
+                }
+            }
+        }
+    }
+    for (const auto& file : *files) {
+        TwoShip3dsInvalidateResource(manager->GetCachedResource(file));
+        if (file.ends_with(".meta")) {
+            TwoShip3dsInvalidateResource(manager->GetCachedResource(file.substr(0, file.size() - 5)));
+        }
+    }
+    // V7 bulk unload removes .meta aliases as well as the listed files.
+    manager->UnloadResources(pattern);
+    return true;
