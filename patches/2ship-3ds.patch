+static bool TwoShip3dsHasPersistentObjectPointers(const char* name) {
+    // RegisterPlayAsKafei copies this skeleton's segment pointer into a static
+    // backup at boot, even while the mode is disabled. A shared_ptr probe cannot
+    // see that owner, and the backup can later be copied into Link's skeleton.
+    if (std::strcmp(name, "object_test3") == 0) {
+        return true;
+    }
+
+    // Actor SkelAnime instances unregister when destroyed. Remaining entries
+    // include the static randomizer item models, whose initialized flag and raw
+    // limb pointers survive scene changes. Protect only registered directories;
+    // an enemy model that has never been drawn does not need to stay resident.
+    const std::string directory = std::string("objects/") + name + "/";
+    for (const auto& skeleton : SOH::SkeletonPatcher::skeletons) {
+        // RegisterSkeleton removes __OTR__ and the alternate-asset prefix.
+        // Do not dereference skelAnime here: only its registered path is needed.
+        if (skeleton.vanillaSkeletonPath.starts_with(directory)) {
+            return true;
+        }
+    }
+    return false;
+}
