+        if (id <= 0 || static_cast<size_t>(id) >= std::size(sTwoShip3dsObjectDirNames)) {
+            continue;
+        }
+        bool duplicate = false;
+        for (s32 j = 0; j < sTwoShip3dsDepartingObjectCount; ++j) {
+            duplicate |= sTwoShip3dsDepartingObjects[j] == id;
