; Fast3D supplies homogeneous clip-space positions, normalized texture
; coordinates, and a single varying combiner input. Preserve w so PICA200 does
; the perspective divide and perspective-correct texture interpolation.

.fvec projection[4]
.fvec stereoEye

.constf shaderConstants(1.0, 0.0, 0.00392156862745, 0.0)

.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outclr color

.in inpos v0
.in intex0 v1
.in intex1 v2
.in incolor v3
.in inStereo v4

.proc main
    ; Shift in logical screen X before rotating for the physical LCD.
    ; Orthographic/rectangle vertices carry zero offset. Keep z and w intact.
    mov r1, inpos
    mul r2.x, stereoEye.x, inStereo.x
    add r1.x, r1.x, r2.x
    dp4 r0.x, projection[0], r1
    dp4 r0.y, projection[1], r1
    dp4 r0.z, projection[2], r1
    dp4 r0.w, projection[3], r1

    ; PICA clips z to [-w, 0]. Clamp there after applying the OpenGL-to-PICA
    ; depth conversion; triangles crossing w=0 are clipped on the CPU.
    min r0.z, shaderConstants.y, r0.z
    max r0.z, r0.z, -r0.w
    mov outpos, r0
    mov outtc0, intex0
    mov outtc1, intex1
    mul outclr, shaderConstants.zzzz, incolor
    end
.end
